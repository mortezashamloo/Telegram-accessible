+    private int lastAnnouncedProgressPercent = -1;
+    private boolean hasAccessibilityFocus = false;
+
+    @Override
+    public void sendAccessibilityEvent(int eventType) {
+        super.sendAccessibilityEvent(eventType);
+        if (eventType == AccessibilityEvent.TYPE_VIEW_ACCESSIBILITY_FOCUSED) {
+            hasAccessibilityFocus = true;
+            lastAnnouncedProgressPercent = -1; // announce fresh as soon as we arrive here
+        } else if (eventType == AccessibilityEvent.TYPE_VIEW_ACCESSIBILITY_FOCUS_CLEARED) {
+            hasAccessibilityFocus = false;
+        }
+    }
+
+    private void announceLoadingProgress(int percent) {
+        if (percent < 0 || percent > 100) {
+            return;
+        }
+        if (!hasAccessibilityFocus) {
+            // Not the message TalkBack is currently on -- stay silent for it.
+            return;
+        }
+        // Throttle to every 5% (plus 100%) so TalkBack isn't overwhelmed.
+        if (percent != 100 && percent != 0 && lastAnnouncedProgressPercent >= 0 && percent / 5 == lastAnnouncedProgressPercent / 5) {
+            return;
+        }
+        if (percent == lastAnnouncedProgressPercent) {
+            return;
+        }
+        lastAnnouncedProgressPercent = percent;
+        AccessibilityManager am = (AccessibilityManager) getContext().getSystemService(Context.ACCESSIBILITY_SERVICE);
+        if (am == null || !am.isEnabled()) {
+            return;
+        }
+        boolean uploading = currentMessageObject != null && currentMessageObject.isSending();
+        String msg = (uploading ? "Uploading " : "Downloading ") + percent + " percent";
+        announceForAccessibility(msg);
+    }
